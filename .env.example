# Токен от @BotFather. Можно не задавать, если нужен только веб-интерфейс (WEB_ADDR).
TELEGRAM_BOT_TOKEN=123456789:AA...

# Числовые Telegram id через запятую — только им бот отвечает и шлёт уведомления.
# Свой id можно узнать у @userinfobot.
TELEGRAM_ALLOWED_IDS=123456789

# Прокси до api.telegram.org, если нужен (http://, https:// или socks5://user:pass@host:port)
#TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Свой Bot API сервер (необязательно)
#TELEGRAM_API_URL=https://api.telegram.org

# Путь к Orca CLI. По умолчанию на Linux — orca-ide, на macOS — orca.
#ORCA_BIN=/usr/local/bin/orca-ide

# Какие рантаймы Orca опрашивать. auto (по умолчанию) — эта машина и все сопряжённые
# серверы из `orca environment list`. Или список через запятую, где local — эта машина:
#ORCA_ENVIRONMENT=local,server

# Агент по умолчанию для /new и /agent
DEFAULT_AGENT=claude

# Как часто проверять статусы агентов для уведомлений
POLL_INTERVAL=5s

# Таймаут одного вызова CLI
ORCA_TIMEOUT=60s

# Где хранить выбор воркспейса и настройки уведомлений
STATE_FILE=/home/USER/.local/state/orca-tg-bot.json

# ---- Веб-интерфейс (необязательно) ----
# Адрес, на котором слушать. Укажите адрес в ZeroTier/домашней сети, а не 0.0.0.0,
# и не открывайте порт в интернет: страница даёт полный доступ к агентам.
#WEB_ADDR=10.147.17.5:8080

# Токен для входа, не короче 12 символов. Сгенерировать: openssl rand -hex 16
#WEB_TOKEN=

# Как часто обновлять статусы, пока страница открыта, и экран открытого терминала
#WEB_POLL_INTERVAL=2s
#WEB_SCREEN_INTERVAL=1s
